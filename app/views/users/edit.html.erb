<div class="editprofile">
  <h1>Edit profile</h1>
  <%= form_with model: @user, local: true do |f| %>
    <% if @user.errors.any? %><p class="form-errors"><%= @user.errors.full_messages.to_sentence %></p><% end %>
    <div><%= f.label :first_name %> <%= f.text_field :first_name %></div>
    <div><%= f.label :last_name %> <%= f.text_field :last_name %></div>
    <div><%= f.label :age %> <%= f.number_field :age %></div>
    <div><%= f.label :location %> <%= f.text_field :location %></div>
    <div><%= f.label :bio %> <%= f.text_area :bio %></div>
    <div><%= f.label :file, "Profile image URL" %> <%= f.url_field :file %></div>
    <%= f.submit "Save profile" %>
  <% end %>
</div>
