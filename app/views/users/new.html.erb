<div class="signup">
  <h1>Sign up for BakR!</h1>
  <%= form_with model: @user, local: true do |f| %>
    <% if @user.errors.any? %><p class="form-errors"><%= @user.errors.full_messages.to_sentence %></p><% end %>
    <div class="signupfields"><%= f.label :first_name %> <%= f.text_field :first_name, required: true %></div>
    <div class="signupfields"><%= f.label :last_name %> <%= f.text_field :last_name, required: true %></div>
    <div class="signupfields"><%= f.label :age %> <%= f.number_field :age, min: 18, required: true %></div>
    <div class="signupfields"><%= f.label :location %> <%= f.text_field :location, required: true %></div>
    <div class="signupfields"><%= f.label :bio %> <%= f.text_area :bio, required: true %></div>
    <div class="signupfields"><%= f.label :email %> <%= f.email_field :email, required: true %></div>
    <div class="signupfields"><%= f.label :password %> <%= f.password_field :password, required: true %></div>
    <div class="signupfields"><%= f.label :password_confirmation %> <%= f.password_field :password_confirmation, required: true %></div>
    <div class="signupfields"><%= f.label :file, "Profile photo URL" %> <%= f.url_field :file %></div>
    <%= f.submit "Sign up", class: "btn" %>
  <% end %>
</div>
