<div class="profile">
  <h1><%= @user.first_name %> <%= @user.last_name %></h1>
  <% if @user.file.present? %>
    <%= image_tag @user.file, size: "260x260", class: "img-circle", alt: "Profile photo" %>
  <% end %>
  <p>Location: <%= @user.location %></p>
  <p>Bio: <%= @user.bio %></p>
  <% if current_user == @user %><p><%= link_to "Edit profile", edit_user_path(@user) %></p><% end %>
</div>
<div class="whatimselling">
  <h2>Currently baking</h2>
  <% if @user.products.empty? %><p>No listings yet.</p><% end %>
  <% @user.products.each do |product| %>
    <div class="userpostings">
      <h3><%= link_to product.description, product_path(product) %></h3>
      <p>Category: <%= product.category %></p>
      <p>Availability: <%= product.available %></p>
      <% if product.product_url.present? %><%= image_tag product.product_url, size: "260x260", alt: product.description %><% end %>
      <% if current_user == @user %>
        <%= link_to "Edit listing", edit_product_path(product) %>
        <%= button_to "Delete listing", product_path(product), method: :delete %>
      <% end %>
    </div>
  <% end %>
</div>
