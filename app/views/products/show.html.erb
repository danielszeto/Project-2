<div class="container">
  <h1><%= @product.description %></h1>
  <% if @product.product_url.present? %>
    <%= image_tag @product.product_url, size: '400x400', alt: @product.description %>
  <% end %>
  <p>Category: <%= @product.category %></p>
  <p>Available: <%= @product.available %></p>
  <% if @product.user %>
    <p>Made by <%= link_to @product.user.first_name, user_path(@product.user) %></p>
    <p><%= mail_to @product.user.email, 'Contact baker' %></p>
  <% end %>
  <% if current_user && @product.user_id == current_user.id %>
    <p><%= link_to 'Edit listing', edit_product_path(@product) %></p>
  <% end %>
  <p><%= link_to 'All listings', products_path %></p>
</div>
