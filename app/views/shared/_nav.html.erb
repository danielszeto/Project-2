<div class="left-nav"><%= link_to "BakR", root_path, class: "brand" %></div>
<div class="right-nav"><%= link_to "Explore bakes", products_path %>
  <% if current_user %>
    <%= link_to "My profile", user_path(current_user) %>
    <%= link_to "Add product", new_product_path %>
    <%= button_to "Sign out", logout_path, method: :delete, class: "nav-button" %>
  <% else %>
    <%= link_to "Sign up", new_user_path %>
    <%= link_to "Sign in", sign_in_path %>
  <% end %>
</div>
