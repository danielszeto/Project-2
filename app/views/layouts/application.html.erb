<!DOCTYPE html>
<html lang="en">
  <head>
    <title>BakR | Homemade baking near you</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <nav class="navbar"><%= render "shared/nav" %></nav>
    <main class="everything">
      <% flash.each do |_type, message| %><p role="status" class="flash"><%= message %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
